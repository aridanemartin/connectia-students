meta {
  name: 02 - Hello (default name)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/hello
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  # Hello (default name)

  No `name` query parameter is sent, so the demo backend falls back to
  "mundo".

  Curl equivalent:

  ```
  curl -sS -i http://localhost:3000/hello
  ```

  Expected: HTTP 200, JSON body `{"message":"Hola, mundo!"}`.
}
